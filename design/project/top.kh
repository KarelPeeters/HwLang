const N = 4;

module top ports(
    clk: in clock,
    sync(clk) {
        data_in: interface [N]Stream(bool).Input,
        data_out: interface [N]Stream(bool).Output,
    }
) {
    comb {
        for (i in 0..N) {
            data_out[i].data = data_in[i].data;
            data_out[i].valid = data_in[i].valid;
            data_in[i].ready = data_out[i].ready;
        }
    }
}

interface Stream(T: type) {
    data: T,
    valid: bool,
    ready: bool,

    view Input { data: in, valid: in, ready: out }
    view Output { data: out, valid: out, ready: in }
}
