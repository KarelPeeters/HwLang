pub module Top ports(
    async {
        value_0: in uint(8),
        value_1: in uint(8),
        value_2: in uint(8),
        total: out uint(0..=765),
    }
) {
    instance Sum(inputs=3) ports(value_0, value_1, value_2, total);
}
