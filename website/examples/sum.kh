pub module Sum(inputs: positive) ports(
    async {
        for (i in 0..inputs) {
            ident("value_{i}"): in uint(8),
        }
        total: out uint(0..=255 * inputs),
    }
) {
    comb {
        var sum = 0;
        for (i in 0..inputs) {
            sum = sum + ident("value_{i}");
        }
        total = sum;
    }
}
